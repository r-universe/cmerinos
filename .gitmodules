[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "APD"]
	path = APD
	url = https://github.com/cmerinos/apd
[submodule "csemTools"]
	path = csemTools
	url = https://github.com/cmerinos/csemtools
[submodule "facomplex"]
	path = facomplex
	url = https://github.com/cmerinos/facomplex
